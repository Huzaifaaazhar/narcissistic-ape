# Copy to .env.local for local dev. Never commit real values.
# Phase 0 needs none of these. Set FEATURE_BACKEND=1 once Supabase/Upstash/Turnstile exist;
# the server then refuses to start unless every backend var below is present and valid.
FEATURE_BACKEND=0

# Public (safe in the browser only because RLS is on for every table)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TURNSTILE_SECRET_KEY=
RUN_SIGNING_SECRET=
IP_HASH_SALT=

# Phase 5
FEATURE_DEAN=0
ANTHROPIC_API_KEY=
